datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id               String     @id @default(uuid())
  name             String
  subscriptionPlan String     @default("STARTER")
  logoUrl          String?
  isTrial          Boolean    @default(true)
  trialStartDate   DateTime?
  trialEndDate     DateTime?
  users            User[]
  outlets          Outlet[]
  menuItems        MenuItem[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  password  String
  name      String?
  role      String   @default("CASHIER")
  outletId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Outlet {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String
  phone     String
  latitude  Float?
  longitude Float?
  orders    Order[]
  tables    Table[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String
  price        Float
  category     String
  imageUrl     String   @db.LongText
  inStock      Boolean  @default(true)
  calories     Int?
  isFavorite   Boolean  @default(false)
  optionGroups Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  items         Json
  totalAmount   Float
  status        String   @default("PENDING")
  paymentMethod String   @default("CASH")
  tableId       String?
  customerName  String?
  notes         String?
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Table {
  id        String   @id @default(uuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  number    Int
  capacity  Int
  status    String   @default("AVAILABLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  phone       String
  email       String?
  points      Int      @default(0)
  tier        String   @default("SILVER")
  totalSpent  Float    @default(0)
  totalVisits Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id           String   @id @default(uuid())
  outletId     String
  name         String
  stock        Float    @default(0)
  unit         String
  minThreshold Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Staff {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  role      String   @default("CASHIER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  category  String
  contact   String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promo {
  id        String   @id @default(uuid())
  outletId  String
  name      String
  type      String   @default("PERCENTAGE")
  value     Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  tenantId    String
  supplierId  String
  items       String
  totalAmount Float    @default(0)
  status      String   @default("PENDING")
  date        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

