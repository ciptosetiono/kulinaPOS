# ============================================
# KulinaPOS - Environment Template
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# ============================================

# --- App Metadata (non-secret, override in .env) ---
APP_NAME="KulinaPOS Enterprise"
APP_VERSION="2.0.0"
ENVIRONMENT="development"

# --- Storage ---
STORAGE_NAMESPACE="kulinapos_v2_"

# --- Feature Flags ---
ENABLE_AI_INSIGHTS="true"
OFFLINE_READY="false"

# --- Sync Configuration ---
SYNC_BACKEND_URL=""
AUTO_SYNC_INTERVAL=60000

# --- Database (Prisma) ---
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="password"
DB_NAME="kulinapos"
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# --- Google AI (Gemini) ---
GOOGLE_AI_API_KEY=[GCP_API_KEY]

# --- SMTP Email Configuration ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="KulinaPOS Enterprise"
SMTP_FROM_EMAIL=noreply@yourdomain.com

