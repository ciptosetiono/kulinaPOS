# ============================================
# KulinaPOS - Environment Template
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# ============================================

# --- App Metadata (non-secret, override in .env) ---
NEXT_PUBLIC_APP_NAME="KulinaPOS Enterprise"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NODE_ENV="development"

# --- Storage ---
NEXT_PUBLIC_STORAGE_NAMESPACE="kulinapos_v2_"

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_AI_INSIGHTS="true"
NEXT_PUBLIC_OFFLINE_READY="false"

# --- Sync Configuration ---
NEXT_PUBLIC_SYNC_BACKEND_URL=""
NEXT_PUBLIC_AUTO_SYNC_INTERVAL=60000

# --- Supabase (Client-Side) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase (Server-Side Only) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database (Prisma) ---
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Google AI (Gemini) ---
API_KEY=your-google-ai-api-key

# --- SMTP Email Configuration ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="KulinaPOS Enterprise"
SMTP_FROM_EMAIL=noreply@yourdomain.com

