
# Arsitektur Aplikasi
VITE_APP_NAME="KulinaPOS Enterprise"
VITE_APP_VERSION="2.0.0-stable"
VITE_ENVIRONMENT="production"

# Persistensi Data (LocalStorage Namespace)
VITE_STORAGE_NAMESPACE="kulinapos_v2_"

# Konektivitas (Mendatang)
VITE_SYNC_BACKEND_URL="https://api.kulinapos.com/v1/sync"
VITE_AUTO_SYNC_INTERVAL=60000

# Fitur Flag
VITE_ENABLE_AI_INSIGHTS=true
VITE_OFFLINE_READY=true
